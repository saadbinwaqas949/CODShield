# Local environment files and credentials. Keep the safe template tracked.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Python bytecode and caches.
__pycache__/
*.py[cod]
*$py.class
.Python

# Virtual environments and local package/build output.
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Test, coverage, and type-checker caches/reports.
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.tox/

# Editor and operating-system files.
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Local logs, temporary files, and database exports/backups.
*.log
*.tmp
*.bak
*.dump
*.sql.gz
*.sqlite
*.sqlite3

# User-uploaded product images are runtime data, not source files.
uploads/**
!uploads/.gitkeep

# uv-created virtual environment named uv
uv/
